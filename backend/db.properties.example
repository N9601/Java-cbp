# Copy this file to db.properties (same folder) and fill in your values.
# db.properties is git-ignored so the real password never reaches the repository.

db.url=jdbc:mysql://localhost:3306/share_market
db.user=root
db.password=your_mysql_password_here

# Price tick interval in seconds
simulator.interval.seconds=5
# Maximum price change per tick, in percent
simulator.max.change.percent=2
# Starting virtual balance for a new user
wallet.initial.balance=100000
